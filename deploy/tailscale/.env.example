# Tailnet DNS suffix (admin console > DNS > Tailnet name)
TS_TAILNET=your-tailnet.ts.net
# Node name; becomes https://tok.<tailnet>. Passkeys are bound to this name: pick it once.
TS_HOSTNAME=tok
# Optional one-off auth key (admin console > Settings > Keys). Leave empty to log in via the link in the logs.
TS_AUTHKEY=
TZ=UTC
# Image tag: latest = newest release; pin e.g. 0.1.0
TOKD_TAG=latest
